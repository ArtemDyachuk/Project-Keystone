{
  "name": "@keystone/cms-api-e2e",
  "version": "0.0.1",
  "private": true,
  "nx": {
    "implicitDependencies": [
      "@keystone/cms-api"
    ],
    "targets": {
      "e2e": {
        "executor": "@nx/jest:jest",
        "outputs": [
          "{projectRoot}/test-output/jest/coverage"
        ],
        "options": {
          "jestConfig": "apps/back-ends/cms-api-e2e/jest.config.ts",
          "passWithNoTests": true
        },
        "dependsOn": [
          "@keystone/cms-api:build",
          "@keystone/cms-api:serve"
        ]
      }
    }
  }
}
