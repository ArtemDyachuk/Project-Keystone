{
  "name": "@keystone/cms-api",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "prebuild": "cd ../../../packages/database && npm run build && cd ../auth && npm run build",
    "build": "tsc",
    "start": "node dist/main.js",
    "dev": "ts-node src/main.ts",
    "lint": "eslint src",
    "type-check": "tsc --noEmit",
    "test": "jest",
    "test:security": "jest --testNamePattern=\"(TENANT SECURITY|AUTHENTICATION SECURITY)\" --verbose",
    "test:watch": "jest --watch"
  },
  "dependencies": {
    "@aws-sdk/client-cognito-identity-provider": "^3.600.0",
    "@keystone/auth": "file:../../../packages/auth",
    "@keystone/database": "file:../../../packages/database",
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@types/cookie-parser": "^1.4.9",
    "cookie-parser": "^1.4.7",
    "express-rate-limit": "^8.0.1",
    "helmet": "^8.1.0",
    "reflect-metadata": "^0.2.2",
    "resend": "^6.0.1",
    "rxjs": "^7.8.0"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.1.6",
    "@types/jest": "^30.0.0",
    "@types/supertest": "^6.0.3",
    "jest": "^30.0.5",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.1",
    "ts-node": "10.9.2"
  }
}
