{
  "name": "@keystone/cms-api",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "prepare": "npm run build:deps",
    "prebuild": "npm run build:deps",
    "build:deps": "cd ../../../packages/auth && npm run build && cd ../database && npm run build",
    "build": "tsc",
    "deploy": "cd ../../.. && npm install && npm run build",
    "start": "node dist/main.js",
    "dev": "ts-node src/main.ts",
    "lint": "eslint src",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@keystone/database": "file:../../../packages/database",
    "@keystone/auth": "file:../../../packages/auth",
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@aws-sdk/client-cognito-identity-provider": "^3.600.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.0"
  },
  "devDependencies": {
    "ts-node": "10.9.1"
  }
}