{
  "name": "@keystone/source",
  "version": "0.0.1",
  "license": "UNLICENSED",
  "scripts": {
    "build": "turbo build --filter='!@keystone/auth-aws'",
    "build:safe": "npm test && turbo build --filter='!@keystone/auth-aws'",
    "dev": "turbo dev --filter=@keystone/cms --filter=@keystone/cms-api",
    "lint": "turbo lint --filter='!@keystone/auth-aws'",
    "type-check": "turbo type-check --filter='!@keystone/auth-aws'",
    "test": "turbo test --filter=@keystone/cms --filter=@keystone/cms-api",
    "test:security": "turbo test --filter='*security*'",
    "clean": "turbo clean && rm -rf node_modules"
  },
  "private": true,
  "packageManager": "npm@10.9.3",
  "dependencies": {
    "dotenv": "^17.2.1",
    "firebase": "^12.1.0",
    "ts-node": "^10.9.2",
    "turbo": "^2.5.5"
  },
  "devDependencies": {
    "@eslint/compat": "^1.1.1",
    "@eslint/eslintrc": "^3.3.1",
    "@eslint/js": "^9.8.0",
    "eslint": "^9.8.0",
    "eslint-config-prettier": "^10.0.0",
    "lint-staged": "^16.1.5",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.29.0"
  },
  "workspaces": [
    "packages/*",
    "apps/front-ends/*",
    "apps/back-ends/*"
  ]
}
