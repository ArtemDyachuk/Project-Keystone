{
  "name": "@keystone/source",
  "version": "0.0.1",
  "license": "UNLICENSED",
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "type-check": "turbo type-check",
    "test": "turbo test",
    "clean": "turbo clean && rm -rf node_modules",
    "build:cms": "turbo build --filter=@keystone/cms",
    "build:cms-api": "turbo build --filter=@keystone/cms-api",
    "build:database": "turbo build --filter=@keystone/database",
    "build:ui": "turbo build --filter=@keystone/ui",
    "dev:cms": "turbo dev --filter=@keystone/cms",
    "dev:cms-api": "turbo dev --filter=@keystone/cms-api"
  },
  "private": true,
  "packageManager": "npm@10.9.3",
  "dependencies": {
    "dotenv": "^17.2.1",
    "turbo": "^2.5.5"
  },
  "devDependencies": {
    "@eslint/compat": "^1.1.1",
    "@eslint/eslintrc": "^3.3.1",
    "@eslint/js": "^9.8.0",
    "eslint": "^9.8.0",
    "eslint-config-prettier": "^10.0.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.29.0"
  },
  "workspaces": [
    "packages/*",
    "apps/front-ends/*",
    "apps/back-ends/*"
  ]
}